        "code.directory",
        "code.dockerfile",
        "code.entry-point",
        "code.env-definition",
        "code.env-var",
        "code.facet",
        "code.file",
        "code.health-endpoint",
        "code.image",
        "code.index",
        "code.input",
        "code.k8s-deployment",
        "code.k8s-service",
        "code.lockfile",
        "code.logger",
        "code.make-target",
        "code.manifest",
        "code.message",
        "code.metrics-endpoint",
        "code.migration",
        "code.module",
        "code.newcomer-command",
        "code.newcomer-failure",
        "code.newcomer-prerequisites",
        "code.operation",
        "code.package",
